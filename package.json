{
  "name": "grihagrid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-spatial-assets.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:ops": "node scripts/check-ops-config.mjs",
    "check:worker": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler/ci-dry-run",
    "check:worker:staging": "wrangler deploy --dry-run --env staging --outdir .wrangler/ci-dry-run-staging",
    "check": "npm run build && npm run test:sites && npm run check:ops",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "node scripts/authenticated-smoke.mjs",
    "canary:account-security": "node scripts/account-security-canary.mjs",
    "monitor:release": "node scripts/monitor-release.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "deploy": "wrangler deploy",
    "spatial:render": "node scripts/spatial/run.mjs",
    "spatial:preview": "node scripts/spatial/run.mjs --mode preview",
    "check:spatial:ui": "node scripts/check-spatial-ui.mjs",
    "predev": "node scripts/prepare-spatial-assets.mjs",
    "spatial:service": "node scripts/spatial/service.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "dompurify": "3.4.15",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "wrangler": "4.131.1"
  }
}
