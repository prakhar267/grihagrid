{
  "name": "grihagrid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:ops": "node scripts/check-ops-config.mjs",
    "check:worker": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler/ci-dry-run",
    "check:worker:staging": "wrangler deploy --dry-run --env staging --outdir .wrangler/ci-dry-run-staging",
    "check": "npm run build && npm run test:sites && npm run check:ops",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.122.0"
  }
}
